<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Front-end tooling (Tailwind/TipTap) installs into node_modules; keep it out of MSBuild globs. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);node_modules\**</DefaultItemExcludes>
    <!--
      The app serves files through UseStaticFiles and negotiates compression at runtime with
      UseResponseCompression; it does not map Static Web Asset endpoints. Do not duplicate CSS/JS
      as publish-time .gz/.br files that this serving path will not select. Versioned URLs and the
      existing static-file cache policy still keep repeat-request CPU/network cost low.
    -->
    <CompressionEnabled>false</CompressionEnabled>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Szaipa.Data\Szaipa.Data.csproj" />
  </ItemGroup>

  <!--
    Tailwind source (admin.input.css) is compiled to wwwroot/admin/admin.css by the npm build; it uses
    @@tailwind directives a browser can't parse, so never serve or publish the raw source.
  -->
  <ItemGroup>
    <Content Update="wwwroot/admin/admin.input.css" CopyToPublishDirectory="Never" />
    <Content Update="wwwroot/admin/src/**" CopyToPublishDirectory="Never" />
    <Content Update="wwwroot/legacy/**/.gitkeep" CopyToPublishDirectory="Never" />
    <Content Update="package.json" CopyToPublishDirectory="Never" />
    <Content Update="package-lock.json" CopyToPublishDirectory="Never" />
    <Content Update="appsettings.Local.example.json" CopyToPublishDirectory="Never" />
    <Content Update="appsettings.Production.example.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <!--
    appsettings.Local.json holds machine-specific secrets (the read-only production DB connection strings).
    It is gitignored, but gitignore does not affect MSBuild: by default it would be copied to bin and into the
    publish output, leaking the production credentials in any deployed/shared artifact. Never copy it anywhere.
  -->
  <ItemGroup>
    <Content Update="appsettings.Local.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    <Content Update="appsettings.Production.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
