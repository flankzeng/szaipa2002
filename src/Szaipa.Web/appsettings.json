{
  "RuntimeSafety": {
    "UseLegacyDataSources": false,
    "AllowLiveDatabase": false,
    "UseHttpsRedirection": false
  },
  "DataProtection": {
    "ApplicationName": "Szaipa.Web",
    "KeysPath": ""
  },
  "LegacyData": {
    "Szaipa": {
      "AccessMode": "Disabled",
      "ConnectionString": ""
    },
    "Tongou": {
      "AccessMode": "Disabled",
      "ConnectionString": ""
    }
  },
  "AdminWrite": {
    "EnableWrites": false
  },
  "SecurityMonitoring": {
    "ServerSecurityRoot": "",
    "RequestAuditEnabled": false,
    "AuditDirectory": "",
    "AuditKeepDays": 30,
    "AuditMaxLineLength": 512,
    "AuditSkipPaths": [ "/healthz", "/favicon.ico" ]
  },
  "ConnectionStrings": {
    "Szaipa": "",
    "Tongou": "",
    "SzaipaAdmin": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
