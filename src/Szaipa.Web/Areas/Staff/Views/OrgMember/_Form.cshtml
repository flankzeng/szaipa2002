@model OrgMemberFormViewModel

<div asp-validation-summary="All" class="mb-4 rounded-lg border border-brand/30 bg-brand/5 px-4 py-3 text-sm text-brand empty:hidden"></div>

<div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
    <div class="lg:col-span-1">
        <label class="admin-label">头像</label>
        <div class="rounded-xl border border-dashed border-black/15 bg-white p-3 text-center"
             data-upload-field data-store="url" data-upload-url="/Staff/Upload/Image?folder=ArtImg/Org" data-target="AvatarPath"
             data-dims-width="ImageWidth" data-dims-height="ImageHeight" data-crop data-crop-ratio="1" data-crop-bw-default="true">
            <div data-upload-trigger class="cursor-pointer rounded-lg px-4 py-8 text-sm text-muted hover:text-brand">
                点击上传头像<br /><span class="text-xs">方形图片，首页按原图比例显示</span>
            </div>
            <img data-upload-preview src="@Model.AvatarPath" alt="头像预览"
                 class="mx-auto mt-2 max-h-48 rounded @(string.IsNullOrEmpty(Model.AvatarPath) ? "hidden" : "")" />
            <div data-upload-status class="mt-1 text-xs text-muted"></div>
            <button type="button" data-upload-clear class="mt-1 text-xs text-muted hover:text-brand">清除头像</button>
        </div>
        <input type="hidden" asp-for="AvatarPath" />
        <input type="hidden" asp-for="ImageWidth" />
        <input type="hidden" asp-for="ImageHeight" />
        <span asp-validation-for="AvatarPath" class="mt-1 block text-xs text-brand"></span>
        <p class="mt-2 text-xs text-muted">头像留空且关联了艺术家时，首页自动使用该艺术家的头像。</p>
    </div>

    <div class="space-y-4 lg:col-span-2">
        <div>
            <label asp-for="Name" class="admin-label"></label>
            <input asp-for="Name" class="admin-input" placeholder="例：张岚芊" autocomplete="off" />
            <span asp-validation-for="Name" class="mt-1 block text-xs text-brand"></span>
        </div>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
            <div>
                <label asp-for="GroupName" class="admin-label"></label>
                <select asp-for="GroupName" class="admin-input">
                    @foreach (var group in OrgGroups.All)
                    {
                        <option value="@group">@group</option>
                    }
                </select>
            </div>
            <div>
                <label asp-for="Role" class="admin-label"></label>
                <input asp-for="Role" class="admin-input" list="org-roles" placeholder="会长 / 副会长 / 会员…（可自填）" autocomplete="off" />
                <datalist id="org-roles">
                    @foreach (var role in OrgRoles.Roles)
                    {
                        <option value="@role"></option>
                    }
                </datalist>
            </div>
            <div>
                <label asp-for="Title" class="admin-label"></label>
                <input asp-for="Title" class="admin-input" list="org-titles" placeholder="艺术家 / 教授…（可自填）" autocomplete="off" />
                <datalist id="org-titles">
                    @foreach (var title in OrgRoles.Titles)
                    {
                        <option value="@title"></option>
                    }
                </datalist>
            </div>
        </div>
        <p class="-mt-2 text-xs text-muted">首页显示为「职务 | 头衔」，任意一项留空则只显示另一项。</p>

        <div>
            <label asp-for="ArtistId" class="admin-label"></label>
            <div class="flex gap-3">
                <select asp-for="ArtistId" class="admin-input" data-artist-select data-avatar-target="AvatarPath">
                    <option value="">（不关联：只显示卡片，没有链接）</option>
                    @foreach (var artist in Model.ArtistOptions)
                    {
                        <option value="@artist.Id" data-name="@artist.Name" data-avatar="@artist.Path">@artist.Name</option>
                    }
                </select>
                <button type="button" data-artist-pull-avatar class="admin-btn-ghost whitespace-nowrap">一键带出头像</button>
            </div>
            <span asp-validation-for="ArtistId" class="mt-1 block text-xs text-brand"></span>
            <p class="mt-1 text-xs text-muted">关联后，首页卡片会链接到该艺术家的官网页面（/Home/Art/编号）。</p>
        </div>

        <label class="flex items-center gap-2 text-sm text-ink/80">
            <input asp-for="IsVisible" type="checkbox" class="h-4 w-4 rounded border-black/20 text-brand focus:ring-brand/30" />
            在首页显示
        </label>
    </div>
</div>
