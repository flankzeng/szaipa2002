@model PublicationFormViewModel
@{
    ViewData["Title"] = "新建展览";
}
<div class="mb-6 flex items-center justify-between">
    <h1 class="font-serif text-2xl font-bold text-ink">新建展览</h1>
    <a asp-action="Index" class="admin-btn-ghost">返回列表</a>
</div>
<form asp-action="Create" method="post" class="rounded-2xl border border-black/5 bg-white p-6 shadow-sm">
    <partial name="_Form" model="Model" />
    <div class="mt-6 flex gap-3 border-t border-black/5 pt-5">
        <button type="submit" class="admin-btn-primary">创建展览</button>
        <a asp-action="Index" class="admin-btn-ghost">取消</a>
    </div>
</form>
@section Scripts {
    <script src="~/admin/gallery-manager.js" defer></script>
}
