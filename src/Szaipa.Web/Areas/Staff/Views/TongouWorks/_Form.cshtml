@model TongouWorksFormViewModel

<div asp-validation-summary="All" class="mb-4 rounded-lg border border-brand/30 bg-brand/5 px-4 py-3 text-sm text-brand empty:hidden"></div>

<div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
    <div class="lg:col-span-1">
        <label class="admin-label">作品图片</label>
        <div class="rounded-xl border border-dashed border-black/15 bg-white p-3 text-center"
             data-upload-field data-upload-url="/Staff/Upload/Image?folder=Tongou/Works" data-target="ImgPath" data-store="url">
            <div data-upload-trigger class="cursor-pointer rounded-lg px-4 py-8 text-sm text-muted hover:text-brand">点击上传作品图片</div>
            <img data-upload-preview src="@Model.ImgPath" alt="作品预览"
                 class="mx-auto mt-2 max-h-48 rounded @(string.IsNullOrEmpty(Model.ImgPath) ? "hidden" : "")" />
            <div data-upload-status class="mt-1 text-xs text-muted"></div>
        </div>
        <input type="hidden" asp-for="ImgPath" />
    </div>

    <div class="grid grid-cols-1 gap-4 lg:col-span-2">
        <div>
            <label asp-for="Atristid" class="admin-label"></label>
            <select asp-for="Atristid" asp-items="ViewBag.Artists" class="admin-input">
                <option value="">请选择艺术家</option>
            </select>
            <span asp-validation-for="Atristid" class="mt-1 block text-xs text-brand"></span>
        </div>
        <div>
            <label asp-for="Title" class="admin-label"></label>
            <input asp-for="Title" class="admin-input" autocomplete="off" />
            <span asp-validation-for="Title" class="mt-1 block text-xs text-brand"></span>
        </div>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
            <div><label asp-for="Size" class="admin-label"></label><input asp-for="Size" class="admin-input" autocomplete="off" /></div>
            <div><label asp-for="Type" class="admin-label"></label><input asp-for="Type" class="admin-input" autocomplete="off" /></div>
            <div><label asp-for="CreationDate" class="admin-label"></label><input asp-for="CreationDate" class="admin-input" autocomplete="off" /></div>
        </div>
    </div>
</div>
