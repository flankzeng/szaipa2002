@model TongouAtristFormViewModel

<div asp-validation-summary="All" class="mb-4 rounded-lg border border-brand/30 bg-brand/5 px-4 py-3 text-sm text-brand empty:hidden"></div>

<div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
    <div class="lg:col-span-1">
        <label class="admin-label">头像</label>
        <div class="rounded-xl border border-dashed border-black/15 bg-white p-3 text-center"
             data-upload-field data-upload-url="/Staff/Upload/Image?folder=Tongou/Atrist" data-target="HeardPath" data-store="url">
            <div data-upload-trigger class="cursor-pointer rounded-lg px-4 py-8 text-sm text-muted hover:text-brand">点击上传头像</div>
            <img data-upload-preview src="@Model.HeardPath" alt="头像预览"
                 class="mx-auto mt-2 max-h-48 rounded-full @(string.IsNullOrEmpty(Model.HeardPath) ? "hidden" : "")" />
            <div data-upload-status class="mt-1 text-xs text-muted"></div>
        </div>
        <input type="hidden" asp-for="HeardPath" />
    </div>

    <div class="grid grid-cols-1 gap-4 lg:col-span-2">
        <div>
            <label asp-for="Name" class="admin-label"></label>
            <input asp-for="Name" class="admin-input" autocomplete="off" />
            <span asp-validation-for="Name" class="mt-1 block text-xs text-brand"></span>
        </div>
        <div>
            <label asp-for="Title" class="admin-label"></label>
            <input asp-for="Title" class="admin-input" autocomplete="off" />
        </div>
        <div>
            <label asp-for="AboutText" class="admin-label"></label>
            <textarea asp-for="AboutText" class="admin-textarea" rows="4" placeholder="艺术家简介"></textarea>
        </div>
    </div>
</div>
