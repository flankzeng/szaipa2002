@model LoginViewModel
@{
    ViewData["Title"] = "登录";
    var returnUrl = ViewData["ReturnUrl"] as string;
}
<div class="flex min-h-[72vh] items-center justify-center">
    <div class="w-full max-w-sm">
        <div class="mb-8 text-center">
            <div class="font-serif text-2xl font-bold tracking-tight text-brand">深圳市艺术产业促进会</div>
            <div class="mt-2 text-[11px] uppercase tracking-[0.3em] text-muted">Backend Console</div>
        </div>
        <form asp-area="Staff" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@returnUrl"
              method="post" class="rounded-2xl border border-black/5 bg-white p-8 shadow-sm">
            <div asp-validation-summary="All" class="mb-4 text-sm text-brand empty:hidden"></div>

            <label asp-for="StaffName" class="mb-1.5 block text-sm text-ink/70"></label>
            <input asp-for="StaffName" autocomplete="username" class="admin-input mb-4" placeholder="账户名" />

            <label asp-for="Password" class="mb-1.5 block text-sm text-ink/70"></label>
            <input asp-for="Password" type="password" autocomplete="current-password" class="admin-input mb-6" placeholder="密码" />

            <button type="submit" class="admin-btn-primary w-full">登 录</button>
        </form>
        <p class="mt-6 text-center text-xs text-muted">深圳市艺术产业促进会内容管理后台 · 仅限授权人员</p>
    </div>
</div>
