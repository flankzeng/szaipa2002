@model PasswordChangeViewModel
@{
    ViewData["Title"] = "修改密码";
}
<div class="mb-6 flex items-center justify-between">
    <h1 class="font-serif text-2xl font-bold text-ink">修改密码</h1>
    <a asp-controller="Dashboard" asp-action="Index" class="admin-btn-ghost">返回</a>
</div>

<form asp-area="Staff" asp-controller="Account" asp-action="PasswordChange" method="post"
      class="max-w-md rounded-2xl border border-black/5 bg-white p-6 shadow-sm">
    <div asp-validation-summary="All" class="mb-4 rounded-lg border border-brand/30 bg-brand/5 px-4 py-3 text-sm text-brand empty:hidden"></div>

    <div class="mb-4">
        <label asp-for="CurrentPassword" class="admin-label"></label>
        <input asp-for="CurrentPassword" type="password" autocomplete="current-password" class="admin-input" />
        <span asp-validation-for="CurrentPassword" class="mt-1 block text-xs text-brand"></span>
    </div>
    <div class="mb-4">
        <label asp-for="NewPassword" class="admin-label"></label>
        <input asp-for="NewPassword" type="password" autocomplete="new-password" class="admin-input" />
        <span asp-validation-for="NewPassword" class="mt-1 block text-xs text-brand"></span>
    </div>
    <div class="mb-6">
        <label asp-for="ConfirmPassword" class="admin-label"></label>
        <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" class="admin-input" />
        <span asp-validation-for="ConfirmPassword" class="mt-1 block text-xs text-brand"></span>
    </div>

    <div class="flex gap-3 border-t border-black/5 pt-5">
        <button type="submit" class="admin-btn-primary">保存新密码</button>
        <a asp-controller="Dashboard" asp-action="Index" class="admin-btn-ghost">取消</a>
    </div>
</form>
