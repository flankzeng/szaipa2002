@model FavFormViewModel
@{
    ViewData["Title"] = "编辑收藏";
}
<div class="mb-6 flex items-center justify-between">
    <h1 class="font-serif text-2xl font-bold text-ink">编辑收藏</h1>
    <a asp-action="Index" class="admin-btn-ghost">返回列表</a>
</div>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="rounded-2xl border border-black/5 bg-white p-6 shadow-sm">
    <partial name="_Form" model="Model" />
    <div class="mt-6 flex gap-3 border-t border-black/5 pt-5">
        <button type="submit" class="admin-btn-primary">保存修改</button>
        <a asp-action="Index" class="admin-btn-ghost">取消</a>
    </div>
</form>
@section Scripts {
    <script src="~/admin/upload-field.js" defer></script>
}
