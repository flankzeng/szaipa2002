@model DashboardViewModel
@{
    ViewData["Title"] = "后台综合";
}
<div class="mb-8 flex items-end justify-between">
    <div>
        <h1 class="font-serif text-2xl font-bold text-ink">后台综合</h1>
        <p class="mt-1 text-sm text-muted">欢迎回来，@User.Identity?.Name。内容管理与访问数据总览。</p>
    </div>
</div>

@if (!Model.DataAvailable)
{
    <div class="mb-8 rounded-2xl border border-brand/20 bg-brand/5 px-5 py-4 text-sm text-brand">
        @Model.UnavailableReason
    </div>
}

@* KPI 指标卡 *@
<div class="mb-8 grid grid-cols-2 gap-4 lg:grid-cols-4">
    <div class="admin-card">
        <p class="text-xs uppercase tracking-wide text-muted">今日访问</p>
        <p class="mt-2 font-serif text-3xl font-bold text-ink">@Model.Kpi.TodayVisits</p>
    </div>
    <div class="admin-card">
        <p class="text-xs uppercase tracking-wide text-muted">本月访问</p>
        <p class="mt-2 font-serif text-3xl font-bold text-ink">@Model.Kpi.MonthVisits</p>
    </div>
    <div class="admin-card">
        <p class="text-xs uppercase tracking-wide text-muted">内容总访问</p>
        <p class="mt-2 font-serif text-3xl font-bold text-ink">@Model.Kpi.ContentAccessTotal</p>
    </div>
    <div class="admin-card">
        <p class="text-xs uppercase tracking-wide text-muted">近7天操作</p>
        <p class="mt-2 font-serif text-3xl font-bold text-ink">@Model.Kpi.RecentOperationCount</p>
    </div>
</div>

@* 折线 + 饼图 *@
<div class="mb-6 grid grid-cols-1 gap-6 lg:grid-cols-3">
    <section class="admin-card lg:col-span-2">
        <h2 class="admin-card__title mb-3">近 30 天访问趋势</h2>
        <div id="chart-daily" class="h-72 w-full"></div>
    </section>
    <section class="admin-card">
        <h2 class="admin-card__title mb-3">内容访问构成</h2>
        <div id="chart-content" class="h-72 w-full"></div>
    </section>
</div>

@* 省市旭日图 *@
<div class="mb-6 grid grid-cols-1 gap-6 lg:grid-cols-2">
    <section class="admin-card">
        <h2 class="admin-card__title mb-3">本月访客分布（省 / 市）</h2>
        <div id="chart-geo-month" class="h-80 w-full"></div>
    </section>
    <section class="admin-card">
        <h2 class="admin-card__title mb-3">本年访客分布（省 / 市）</h2>
        <div id="chart-geo-year" class="h-80 w-full"></div>
    </section>
</div>

@* 操作记录 *@
<section class="admin-card">
    <div class="mb-4 flex items-center justify-between gap-4">
        <h2 class="admin-card__title">近期操作记录</h2>
        <a asp-area="Staff" asp-controller="Operations" asp-action="Index"
           class="text-sm font-medium text-brand hover:underline">查看全部</a>
    </div>
    @if (Model.Operations.Count == 0)
    {
        <p class="text-sm text-muted">暂无操作记录。</p>
    }
    else
    {
        <div class="space-y-5">
            @foreach (var day in Model.Operations)
            {
                <div>
                    <p class="mb-2 text-xs font-medium uppercase tracking-wide text-muted">@day.Date</p>
                    <ul class="space-y-1.5 border-l-2 border-brand/20 pl-4">
                        @foreach (var record in day.Records)
                        {
                            <li class="text-sm text-ink/80">@record</li>
                        }
                    </ul>
                </div>
            }
        </div>
    }
</section>

@section Scripts {
    <script src="~/admin/dashboard.js" asp-append-version="true" defer></script>
}
