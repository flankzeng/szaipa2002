@model PartnerFormViewModel

<div asp-validation-summary="All" class="mb-4 rounded-lg border border-brand/30 bg-brand/5 px-4 py-3 text-sm text-brand empty:hidden"></div>

<div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
    <div class="lg:col-span-1">
        <label class="admin-label">Logo</label>
        <div class="rounded-xl border border-dashed border-black/15 bg-white p-3 text-center"
             data-upload-field data-store="url" data-upload-url="/Staff/Upload/Image?folder=images/partners" data-target="LogoPath"
             data-dims-width="ImageWidth" data-dims-height="ImageHeight">
            <div data-upload-trigger class="cursor-pointer rounded-lg px-4 py-8 text-sm text-muted hover:text-brand">
                点击上传 Logo<br /><span class="text-xs">建议方形（800 × 800）</span>
            </div>
            <img data-upload-preview src="@Model.LogoPath" alt="Logo 预览"
                 class="mx-auto mt-2 max-h-48 rounded @(string.IsNullOrEmpty(Model.LogoPath) ? "hidden" : "")" />
            <div data-upload-status class="mt-1 text-xs text-muted"></div>
            <button type="button" data-upload-clear class="mt-1 text-xs text-muted hover:text-brand">清除 Logo</button>
        </div>
        <input type="hidden" asp-for="LogoPath" />
        <input type="hidden" asp-for="ImageWidth" />
        <input type="hidden" asp-for="ImageHeight" />
        <span asp-validation-for="LogoPath" class="mt-1 block text-xs text-brand"></span>
    </div>

    <div class="space-y-4 lg:col-span-2">
        <div>
            <label asp-for="Name" class="admin-label"></label>
            <textarea asp-for="Name" class="admin-textarea" rows="2" placeholder="名称较长时可换行，页面会按换行显示"></textarea>
            <span asp-validation-for="Name" class="mt-1 block text-xs text-brand"></span>
        </div>
        <div>
            <label asp-for="Link" class="admin-label"></label>
            <input asp-for="Link" class="admin-input" placeholder="https://…（可选；填写后 Logo 与名称可点击）" autocomplete="off" />
            <span asp-validation-for="Link" class="mt-1 block text-xs text-brand"></span>
        </div>
        <div>
            <label asp-for="Description" class="admin-label"></label>
            <textarea asp-for="Description" class="admin-textarea" rows="8" placeholder="仅桌面端显示。段落之间空一行即可。"></textarea>
        </div>
        <label class="flex items-center gap-2 text-sm text-ink/80">
            <input asp-for="IsVisible" type="checkbox" class="h-4 w-4 rounded border-black/20 text-brand focus:ring-brand/30" />
            在「关于我们」页显示
        </label>
    </div>
</div>
