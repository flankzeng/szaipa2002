@model IReadOnlyList<Szaipa.Data.Contexts.Szaipa.FeaturedExhibition>
@using Szaipa.Data.Composition
@{ ViewData["Title"]="首页推荐"; }
<div class="mb-6 flex justify-between"><h1 class="font-serif text-2xl font-bold">首页推荐展览</h1><a asp-action="Create" class="admin-btn-primary">＋ 添加推荐</a></div>
@if (ViewData["SchemaWarning"] is string warning) { <p class="mb-4 rounded-lg border border-amber-300 bg-amber-50 p-3 text-sm text-amber-900">@warning</p> }
<div class="space-y-3">@foreach(var row in Model){var lifecycle=PublicationLifecycleCalculator.Compute(row.Status,row.StartDate,row.EndDate,DateTime.Today);<div class="flex flex-wrap items-center gap-4 rounded-xl bg-white p-4"><div class="min-w-48 flex-1"><strong>@row.Title</strong><div class="text-xs text-muted">@row.LinkUrl · 顺序 @row.SortOrder · @PublicationLifecycleCalculator.Label(lifecycle) · @(row.IsVisible?"显示":"隐藏") @(row.ShowInCarousel?"· 轮播":"")</div></div><form asp-action="Move" asp-route-id="@row.Id" method="post"><input type="hidden" name="direction" value="-1"/><button class="admin-btn-ghost">↑</button></form><form asp-action="Move" asp-route-id="@row.Id" method="post"><input type="hidden" name="direction" value="1"/><button class="admin-btn-ghost">↓</button></form><a asp-action="Edit" asp-route-id="@row.Id" class="text-brand">编辑</a><form asp-action="Delete" asp-route-id="@row.Id" method="post"><button class="text-muted">删除</button></form></div>}</div>
