@model Szaipa.Data.Contexts.Szaipa.FeaturedExhibition
@{ var editing=Model.Id>0; ViewData["Title"]=editing?"编辑首页推荐":"添加首页推荐"; }
<h1 class="mb-6 font-serif text-2xl font-bold">@ViewData["Title"]</h1><form asp-action="@(editing?"Edit":"Create")" asp-route-id="@Model.Id" method="post" class="space-y-4 rounded-2xl bg-white p-6">
<div><label class="admin-label">标题</label><input asp-for="Title" class="admin-input" required/></div><div><label class="admin-label">链接（本站路径）</label><input asp-for="LinkUrl" class="admin-input" placeholder="/Home/Publication/92011" required/></div><div><label class="admin-label">年份</label><input asp-for="YearText" class="admin-input"/></div><div><label class="admin-label">展讯（每行一条）</label><textarea asp-for="InfoLines" rows="4" class="admin-textarea"></textarea></div><div><label class="admin-label">图片（首页卡片滑动图，每行一个路径；可直接上传）</label><textarea asp-for="ImageUrls" rows="4" class="admin-textarea" data-path-upload></textarea></div><div><label class="admin-label">Logo（轮播左上角）</label><input asp-for="LogoUrl" class="admin-input" data-path-upload/></div><div><label class="admin-label">封面（轮播大图）</label><input asp-for="CoverUrl" class="admin-input" data-path-upload/></div><div class="grid gap-3 sm:grid-cols-2"><div><label class="admin-label">开始日期</label><input asp-for="StartDate" type="date" class="admin-input"/></div><div><label class="admin-label">结束日期</label><input asp-for="EndDate" type="date" class="admin-input"/></div></div><div><label class="admin-label">状态</label><select asp-for="Status" class="admin-input"><option value="true">按日期自动</option><option value="false">手动强制已结束</option><option value="">下架</option></select></div><div><label class="admin-label">排序</label><input asp-for="SortOrder" type="number" class="admin-input"/></div><label class="block"><input asp-for="IsVisible"/> 首页显示</label><label class="block"><input asp-for="ShowInCarousel"/> 同时接管首页轮播 <span class="text-xs text-muted">（勾选后轮播中同链接的幻灯片改用本条数据；再取消「首页显示」即可从轮播移除。不勾选则轮播保持原样）</span></label><button class="admin-btn-primary">保存</button><a asp-action="Index" class="admin-btn-ghost">取消</a></form>
@section Scripts { <script src="~/admin/path-upload.js" asp-append-version="true"></script> }
