@model PagedResult<News>
@inject Szaipa.Web.Services.IImageVariants ImageVariants
@{
    ViewData["Title"] = "新闻管理";
}
<div class="mb-6 flex items-center justify-between">
    <div>
        <h1 class="font-serif text-2xl font-bold text-ink">新闻管理</h1>
        <p class="mt-1 text-sm text-muted">共 @Model.TotalCount 条</p>
    </div>
    <a asp-action="Create" class="admin-btn-primary">＋ 添加新闻</a>
</div>

@* 窄屏时表格可左右滑动，避免右侧「编辑/删除」被裁掉。 *@
<div class="overflow-x-auto rounded-2xl border border-black/5 bg-white shadow-sm">
    <table class="w-full text-sm">
        <thead class="border-b border-black/5 bg-canvas/60 text-left text-xs uppercase tracking-wide text-muted">
            <tr>
                <th class="px-5 py-3 font-medium">标题</th>
                <th class="whitespace-nowrap px-5 py-3 font-medium">日期</th>
                <th class="whitespace-nowrap px-5 py-3 font-medium">展示封面</th>
                <th class="whitespace-nowrap px-5 py-3 text-right font-medium">操作</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-black/5">
            @foreach (var n in Model.Items)
            {
                <tr class="hover:bg-canvas/40">
                    <td class="px-5 py-3">
                        <div class="flex items-center gap-3">
                        @* 封面缩略图：勾「展示封面」前先看一眼封面是否合适；没有封面的不能勾（前台会是破图）。 *@
                        @if (!string.IsNullOrEmpty(n.CoverPath))
                        {
                            <img src="@ImageVariants.Url($"/Content/newsImg/{n.CoverPath}", 480)" alt="" loading="lazy" class="h-10 w-16 shrink-0 rounded object-cover" />
                        }
                        else
                        {
                            <div class="flex h-10 w-16 shrink-0 items-center justify-center rounded bg-canvas text-[10px] text-muted">无封面</div>
                        }
                        <div class="min-w-0">
                        <div class="font-medium text-ink">@n.Title</div>
                        @if (!string.IsNullOrEmpty(n.Subtitle))
                        {
                            <div class="mt-0.5 line-clamp-1 text-xs text-muted">@n.Subtitle</div>
                        }
                        </div>
                        </div>
                    </td>
                    <td class="whitespace-nowrap px-5 py-3 text-muted">@(n.Date?.ToString("yyyy-MM-dd") ?? "—")</td>
                    <td class="whitespace-nowrap px-5 py-3">
                        @* 勾选即提交（= News.Important）；表单里放的是"切换后的值"，不依赖复选框未勾选时不提交的行为。 *@
                        @if (n.Important == true || !string.IsNullOrEmpty(n.CoverPath))
                        {
                            <form asp-action="Important" asp-route-id="@n.Id" method="post" class="inline">
                                <input type="hidden" name="important" value="@((n.Important != true).ToString().ToLowerInvariant())" />
                                <input type="hidden" name="page" value="@Model.Page" />
                                <label class="inline-flex cursor-pointer items-center gap-1.5 text-xs @(n.Important == true ? "text-brand" : "text-muted")">
                                    <input type="checkbox" checked="@(n.Important == true)" onchange="this.form.submit()"
                                           class="h-4 w-4 rounded border-black/20 text-brand focus:ring-brand/30" />
                                    @(n.Important == true ? "展示" : "不展示")
                                </label>
                            </form>
                        }
                        else
                        {
                            <span class="text-xs text-muted" title="先在编辑页上传封面">无封面</span>
                        }
                    </td>
                    <td class="whitespace-nowrap px-5 py-3">
                        <div class="flex items-center justify-end gap-3">
                            <a asp-action="Edit" asp-route-id="@n.Id" class="text-brand hover:underline">编辑</a>
                            <form asp-action="Delete" asp-route-id="@n.Id" method="post" class="inline"
                                  onsubmit="return confirm('确定删除这条新闻？此操作不可撤销。');">
                                <button type="submit" class="text-muted hover:text-brand">删除</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            @if (Model.Items.Count == 0)
            {
                <tr><td colspan="4" class="px-5 py-14 text-center text-muted">暂无新闻，点击右上角添加。</td></tr>
            }
        </tbody>
    </table>
</div>

@if (Model.TotalPages > 1)
{
    <div class="mt-5 flex items-center justify-center gap-2 text-sm">
        @if (Model.HasPrevious)
        {
            <a asp-action="Index" asp-route-page="@(Model.Page - 1)" class="admin-btn-ghost px-3 py-1.5">上一页</a>
        }
        <span class="px-3 py-1.5 text-muted">第 @Model.Page / @Model.TotalPages 页</span>
        @if (Model.HasNext)
        {
            <a asp-action="Index" asp-route-page="@(Model.Page + 1)" class="admin-btn-ghost px-3 py-1.5">下一页</a>
        }
    </div>
}
