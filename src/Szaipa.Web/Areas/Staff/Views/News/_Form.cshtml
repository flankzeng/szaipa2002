@model NewsFormViewModel

<div asp-validation-summary="All" class="mb-4 rounded-lg border border-brand/30 bg-brand/5 px-4 py-3 text-sm text-brand empty:hidden"></div>

<div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
    <div class="lg:col-span-1">
        <label class="admin-label">新闻封面</label>
        <div class="rounded-xl border border-dashed border-black/15 bg-white p-3 text-center"
             data-upload-field data-upload-url="/Staff/Upload/Image?folder=newsImg" data-target="CoverPath">
            <div data-upload-trigger class="cursor-pointer rounded-lg px-4 py-8 text-sm text-muted hover:text-brand">
                点击上传封面<br /><span class="text-xs">建议尺寸 1150 × 450</span>
            </div>
            <img data-upload-preview src="@Model.CoverUrl" alt="封面预览"
                 class="mx-auto mt-2 max-h-48 rounded @(string.IsNullOrEmpty(Model.CoverUrl) ? "hidden" : "")" />
            <div data-upload-status class="mt-1 text-xs text-muted"></div>
        </div>
        <input type="hidden" asp-for="CoverPath" />
    </div>

    <div class="space-y-4 lg:col-span-2">
        <div>
            <label asp-for="Title" class="admin-label"></label>
            <input asp-for="Title" class="admin-input" placeholder="新闻的主标题" autocomplete="off" />
            <span asp-validation-for="Title" class="mt-1 block text-xs text-brand"></span>
        </div>
        <div>
            <label asp-for="Subtitle" class="admin-label"></label>
            <textarea asp-for="Subtitle" class="admin-textarea" rows="2" placeholder="短篇幅介绍"></textarea>
        </div>
        <div>
            <label asp-for="Link" class="admin-label"></label>
            <input asp-for="Link" class="admin-input" placeholder="转载来源链接（留空视为原创）" autocomplete="off" />
        </div>
        <label class="flex items-center gap-2 text-sm text-ink/80">
            <input asp-for="Important" type="checkbox" class="h-4 w-4 rounded border-black/20 text-brand focus:ring-brand/30" />
            标为重要新闻（首页置顶展示）
        </label>
    </div>
</div>

<div class="mt-6">
    <label class="admin-label">正文</label>
    @await Html.PartialAsync("_RichTextEditor", new RichTextEditorModel
    {
        Name = "Content",
        InitialHtml = Model.Content,
        UploadFolder = "newsImg",
        Placeholder = "在此撰写新闻正文，可插入图片…"
    })
</div>
