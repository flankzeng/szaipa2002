@model ArtistFormViewModel

<div asp-validation-summary="All" class="mb-4 rounded-lg border border-brand/30 bg-brand/5 px-4 py-3 text-sm text-brand empty:hidden"></div>

<div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
    <div class="lg:col-span-1 space-y-4">
        <div>
            <label class="admin-label">头像</label>
            <div class="rounded-xl border border-dashed border-black/15 bg-white p-3 text-center"
                 data-upload-field data-upload-url="/Admin/Upload/Image?folder=ArtImg/Artist" data-target="Path">
                <div data-upload-trigger class="cursor-pointer rounded-lg px-4 py-8 text-sm text-muted hover:text-brand">
                    点击上传头像
                </div>
                <img data-upload-preview src="@Model.PathUrl" alt="头像预览"
                     class="mx-auto mt-2 max-h-32 rounded-full @(string.IsNullOrEmpty(Model.PathUrl) ? "hidden" : "")" />
                <div data-upload-status class="mt-1 text-xs text-muted"></div>
            </div>
            <input type="hidden" asp-for="Path" />
        </div>

        <div>
            <label class="admin-label">背景图 1</label>
            <div class="rounded-xl border border-dashed border-black/15 bg-white p-3 text-center"
                 data-upload-field data-upload-url="/Admin/Upload/Image?folder=ArtImg/Artist/Banner" data-target="Path1">
                <div data-upload-trigger class="cursor-pointer rounded-lg px-4 py-6 text-sm text-muted hover:text-brand">
                    点击上传背景图 1
                </div>
                <img data-upload-preview src="@Model.Path1Url" alt="背景图 1 预览"
                     class="mx-auto mt-2 max-h-32 rounded @(string.IsNullOrEmpty(Model.Path1Url) ? "hidden" : "")" />
                <div data-upload-status class="mt-1 text-xs text-muted"></div>
            </div>
            <input type="hidden" asp-for="Path1" />
        </div>

        <div>
            <label class="admin-label">背景图 2</label>
            <div class="rounded-xl border border-dashed border-black/15 bg-white p-3 text-center"
                 data-upload-field data-upload-url="/Admin/Upload/Image?folder=ArtImg/Artist/Banner" data-target="Path2">
                <div data-upload-trigger class="cursor-pointer rounded-lg px-4 py-6 text-sm text-muted hover:text-brand">
                    点击上传背景图 2
                </div>
                <img data-upload-preview src="@Model.Path2Url" alt="背景图 2 预览"
                     class="mx-auto mt-2 max-h-32 rounded @(string.IsNullOrEmpty(Model.Path2Url) ? "hidden" : "")" />
                <div data-upload-status class="mt-1 text-xs text-muted"></div>
            </div>
            <input type="hidden" asp-for="Path2" />
        </div>

        <div class="grid grid-cols-2 gap-3">
            <div>
                <label asp-for="Color1" class="admin-label"></label>
                <input asp-for="Color1" type="color" class="h-10 w-full rounded-lg border border-black/10" />
            </div>
            <div>
                <label asp-for="Color2" class="admin-label"></label>
                <input asp-for="Color2" type="color" class="h-10 w-full rounded-lg border border-black/10" />
            </div>
        </div>
    </div>

    <div class="space-y-4 lg:col-span-2">
        <div class="grid grid-cols-2 gap-4">
            <div>
                <label asp-for="ArtistNameCN" class="admin-label"></label>
                <input asp-for="ArtistNameCN" class="admin-input" placeholder="会员中文名" autocomplete="off" />
                <span asp-validation-for="ArtistNameCN" class="mt-1 block text-xs text-brand"></span>
            </div>
            <div>
                <label asp-for="ArtistNameEN" class="admin-label"></label>
                <input asp-for="ArtistNameEN" class="admin-input" placeholder="会员英文名" autocomplete="off" />
            </div>
        </div>

        <div class="grid grid-cols-3 gap-4">
            <div>
                <label asp-for="Sex" class="admin-label"></label>
                <select asp-for="Sex" class="admin-input">
                    <option value="男">男</option>
                    <option value="女">女</option>
                </select>
            </div>
            <div>
                <label asp-for="Nation" class="admin-label"></label>
                <input asp-for="Nation" class="admin-input" placeholder="所在国家" autocomplete="off" />
            </div>
            <div>
                <label asp-for="City" class="admin-label"></label>
                <input asp-for="City" class="admin-input" placeholder="常驻城市" autocomplete="off" />
            </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
            <div>
                <label asp-for="Title" class="admin-label"></label>
                <input asp-for="Title" class="admin-input" placeholder="例：会员｜艺术家" autocomplete="off" />
            </div>
            <div>
                <label asp-for="Position" class="admin-label"></label>
                <input asp-for="Position" class="admin-input" placeholder="社会职务" autocomplete="off" />
            </div>
        </div>

        <div>
            <label asp-for="Introduction" class="admin-label"></label>
            <textarea asp-for="Introduction" class="admin-textarea" rows="4" placeholder="艺术家简介"></textarea>
        </div>

        <div>
            <label asp-for="Honor" class="admin-label"></label>
            <textarea asp-for="Honor" class="admin-textarea" rows="3" placeholder="获奖荣誉"></textarea>
        </div>
    </div>
</div>

<div class="mt-6">
    <label class="admin-label">艺术家年表</label>
    @await Html.PartialAsync("_RichTextEditor", new RichTextEditorModel
    {
        Name = "DeedsThings",
        InitialHtml = Model.DeedsThings,
        UploadFolder = "ArtImg/Artist",
        Placeholder = "按年份记录艺术家的展览、获奖等经历…"
    })
</div>
