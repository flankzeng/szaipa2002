@{
    var title = ViewData["Title"] as string;
    var staffName = User?.Identity?.Name;
    var isAuthenticated = User?.Identity?.IsAuthenticated == true;
    string ActiveController() => (ViewContext.RouteData.Values["controller"] as string) ?? string.Empty;
    string NavClass(string controller) => string.Equals(ActiveController(), controller, StringComparison.OrdinalIgnoreCase)
        ? "text-brand border-brand"
        : "text-ink/70 border-transparent hover:text-brand hover:border-brand/40";
    var contentControllers = new[] { "News", "ArtNews", "Artist", "Publication", "Fav", "Auction", "Exhibition" };
    var contentActive = contentControllers.Contains(ActiveController(), StringComparer.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(string.IsNullOrEmpty(title) ? "赛丽美术馆 · 后台" : title + " · 赛丽后台")</title>
    <link rel="icon" href="/Content/123/szaipa.ico" type="image/x-icon" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@300;400;500;700&family=Noto+Serif+SC:wght@400;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/admin/admin.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="min-h-screen bg-canvas text-ink font-sans antialiased">
    @if (isAuthenticated)
    {
        <header class="sticky top-0 z-30 border-b border-black/5 bg-white/90 backdrop-blur">
            <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-6">
                <div class="flex items-center gap-8">
                    <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="flex items-baseline gap-2">
                        <span class="font-serif text-xl font-bold tracking-tight text-brand">赛丽</span>
                        <span class="text-xs font-medium uppercase tracking-[0.2em] text-muted">Admin</span>
                    </a>
                    <nav class="hidden items-center gap-6 md:flex">
                        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"
                           class="border-b-2 px-1 py-1 text-sm font-medium transition-colors @NavClass("Dashboard")">后台综合</a>
                        <div class="group relative">
                            <button type="button"
                                    class="flex items-center gap-1 border-b-2 px-1 py-1 text-sm font-medium transition-colors @(contentActive ? "text-brand border-brand" : "text-ink/70 border-transparent group-hover:text-brand")">
                                内容管理 <span class="text-xs">▾</span>
                            </button>
                            <div class="invisible absolute left-0 top-full z-40 w-40 translate-y-1 rounded-xl border border-black/5 bg-white p-1.5 opacity-0 shadow-lg transition-all group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
                                <a asp-area="Admin" asp-controller="News" asp-action="Index" class="block rounded-lg px-3 py-2 text-sm text-ink/80 hover:bg-canvas hover:text-brand">新闻</a>
                                <a asp-area="Admin" asp-controller="ArtNews" asp-action="Index" class="block rounded-lg px-3 py-2 text-sm text-ink/80 hover:bg-canvas hover:text-brand">艺术家动态</a>
                                <a asp-area="Admin" asp-controller="Artist" asp-action="Index" class="block rounded-lg px-3 py-2 text-sm text-ink/80 hover:bg-canvas hover:text-brand">会员管理</a>
                                <a asp-area="Admin" asp-controller="Publication" asp-action="Index" class="block rounded-lg px-3 py-2 text-sm text-ink/80 hover:bg-canvas hover:text-brand">展览</a>
                                <a asp-area="Admin" asp-controller="Fav" asp-action="Index" class="block rounded-lg px-3 py-2 text-sm text-ink/80 hover:bg-canvas hover:text-brand">收藏</a>
                                <a asp-area="Admin" asp-controller="Auction" asp-action="Index" class="block rounded-lg px-3 py-2 text-sm text-ink/80 hover:bg-canvas hover:text-brand">拍卖</a>
                                <a asp-area="Admin" asp-controller="Exhibition" asp-action="Index" class="block rounded-lg px-3 py-2 text-sm text-ink/80 hover:bg-canvas hover:text-brand">展览</a>
                            </div>
                        </div>
                    </nav>
                </div>
                <div class="flex items-center gap-4">
                    <span class="hidden text-sm text-muted sm:inline">@staffName</span>
                    <form asp-area="Admin" asp-controller="Account" asp-action="Logout" method="post" class="inline">
                        @Html.AntiForgeryToken()
                        <button type="submit"
                                class="rounded-full border border-black/10 px-4 py-1.5 text-sm text-ink/70 transition-colors hover:border-brand hover:text-brand">
                            退出
                        </button>
                    </form>
                </div>
            </div>
        </header>
    }

    <main class="mx-auto max-w-7xl px-6 py-8">
        @if (TempData["Success"] is string success && !string.IsNullOrEmpty(success))
        {
            <div class="mb-6 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800">@success</div>
        }
        @if (TempData["Error"] is string error && !string.IsNullOrEmpty(error))
        {
            <div class="mb-6 rounded-lg border border-brand/30 bg-brand/5 px-4 py-3 text-sm text-brand">@error</div>
        }
        @RenderBody()
    </main>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
