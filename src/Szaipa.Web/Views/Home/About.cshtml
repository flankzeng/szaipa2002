@inject Szaipa.Web.Services.IHomeBlocksProvider HomeBlocks
@{
    ViewData["Title"] = "关于我们";
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
    var partners = await HomeBlocks.GetPartnersAsync(Context.RequestAborted);

    // 只允许 http(s) 外链，其余（含 javascript:）一律不渲染成链接。
    static string? SafeLink(string? link) =>
        !string.IsNullOrWhiteSpace(link)
        && (link.StartsWith("http://", StringComparison.OrdinalIgnoreCase)
            || link.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
            ? link.Trim()
            : null;

    // 名称里的换行输出为 <br />，其余内容照常 HTML 转义。
    Microsoft.AspNetCore.Html.IHtmlContent NameLines(string name) =>
        Html.Raw(string.Join("<br />", name.Split('\n').Select(line => Html.Encode(line.Trim()))));
}

@section Styles {
    <link rel="stylesheet" href="~/css/public-pages.css" asp-append-version="true" />
}

<section id="section01" class="col-xs20 col-sm20 col-md20 col-lg20" style="padding-top: 7vh;">
    <div class="col-xs2 col-sm2 col-md2 col-lg2">&nbsp;</div>
    <div class="col-xs16 col-sm16 col-md16 col-lg16">

        <!-- 关于我们 -->
        <p class="chapter JhengBold">关于我们&ensp;<i class="entitle">|</i>
            <span style="font-family: 'dinLightI';">ABOUT US</span>
        </p>

         <div class="col-xs20 col-sm20 md-hide lg-hide zhangcheng" style="margin-bottom:3em;"></div>

        <article class="col-xs20 col-sm20 col-md20 col-lg20 chapterTXT">
            <p class="col-xs20 col-sm20 md-hide lg-hide">
            @LiveEdit.Text("about.introduction.founding", "深圳市艺术产业促进会成立于2020年9月，是中华人民共和国民政部批准注册、深圳市文化广电旅游体育局主管的社会团体，由艺术家、设计师、艺术领域专家学者及艺术产业相关企业等五十余会员共同发起。现有个人及企业会员五百余人。")
            @LiveEdit.Text("about.introduction.mission", "深圳市艺术产业促进会自成立以来，始终坚持国际视野的格局与创新精神，坚持以创新驱动为导向，促进重点企业和产品的全面发展；配合国家“一带一路”建设，争创大湾区艺术产业服务平台龙头，推动大湾区对外文化艺术新格局。计划与全球著名美术馆及建立良好交流合作体系，为国内外艺术家举办高质量展览，搭建交流访学桥梁；助力外商投资，组建国内外顶级专家咨询团队以服务艺术企业，为国内外尖端艺术类院校搭建合作平台，引进人才，以此推动深圳艺术产业高质量发展。")
            <br />
            @LiveEdit.Text("about.introduction.projects", "深圳市艺术产业促进会在主管单位的关心与支持下不忘初心，积极对接产、学、研、展四大领域，为艺术产业上下游穿针引线，牢牢抓住艺术与科技发展主线，确立协会中长期重大项目——深圳“SIAA”国际艺术奖，此综合性国际当代艺术奖项将立足于深圳，聚焦全球创新与深圳独有的科技特色，若成功举办，将成为深圳全新的城市名片，助力深圳以更加昂扬的姿态屹立于世界先进城市之林，成为竞争力、创新力、影响力卓著的全球标杆城市。协会活跃于深圳市文化行业招商引资、积极参与文博会等政府重点展会项目、吸纳企业及个人会员、参与各类公益性文化艺术活动。成立3年多来，协会企业与个人会员累计已超500家（人），顺利举办30余场各类文化艺术活动。")
            </p>

            <p class="col-md12 col-lg12 sm-hide xs-hide" style="padding-right:3em;">
            @LiveEdit.Text("about.introduction.founding", "深圳市艺术产业促进会成立于2020年9月，是中华人民共和国民政部批准注册、深圳市文化广电旅游体育局主管的社会团体，由艺术家、设计师、艺术领域专家学者及艺术产业相关企业等五十余会员共同发起。现有个人及企业会员五百余人。")
            @LiveEdit.Text("about.introduction.mission", "深圳市艺术产业促进会自成立以来，始终坚持国际视野的格局与创新精神，坚持以创新驱动为导向，促进重点企业和产品的全面发展；配合国家“一带一路”建设，争创大湾区艺术产业服务平台龙头，推动大湾区对外文化艺术新格局。计划与全球著名美术馆及建立良好交流合作体系，为国内外艺术家举办高质量展览，搭建交流访学桥梁；助力外商投资，组建国内外顶级专家咨询团队以服务艺术企业，为国内外尖端艺术类院校搭建合作平台，引进人才，以此推动深圳艺术产业高质量发展。")
            <br /><br />
            @LiveEdit.Text("about.introduction.projects", "深圳市艺术产业促进会在主管单位的关心与支持下不忘初心，积极对接产、学、研、展四大领域，为艺术产业上下游穿针引线，牢牢抓住艺术与科技发展主线，确立协会中长期重大项目——深圳“SIAA”国际艺术奖，此综合性国际当代艺术奖项将立足于深圳，聚焦全球创新与深圳独有的科技特色，若成功举办，将成为深圳全新的城市名片，助力深圳以更加昂扬的姿态屹立于世界先进城市之林，成为竞争力、创新力、影响力卓著的全球标杆城市。协会活跃于深圳市文化行业招商引资、积极参与文博会等政府重点展会项目、吸纳企业及个人会员、参与各类公益性文化艺术活动。成立3年多来，协会企业与个人会员累计已超500家（人），顺利举办30余场各类文化艺术活动。")
            </p>

            <div class="xs-hide sm-hide col-md8 col-lg8 zhangcheng"></div>
<div class="col-xs20 col-sm20 col-md20 col-lg20">
            <button
                onclick="window.open('/Content/images/艺促会介绍.pdf#toolbar=0&navpanes=0&scrollbar=0', '_blank')">查阅详细文档</button>
</div>

        </article>


    </div>
    <div class="col-xs2 col-sm2 col-md2 col-lg2">&nbsp;</div>
</section>

<section id="section02" class="col-xs20 col-sm20 col-md20 col-lg20">
    <div class="col-xs2 col-sm2 col-md2 col-lg2">&nbsp;</div>
    <div class="col-xs16 col-sm16 col-md16 col-lg16">

        <!-- 合作伙伴 -->
        <p class="chapter JhengBold">合作伙伴&ensp;<i class="entitle">|</i>
            <span style="font-family: 'dinLightI';">COLLABORATION PARTNER</span>
        </p>


        <ul class="partner">
            @* 2026-10-26 T3：合作伙伴改为数据渲染（后台「合作伙伴」）；缺表/无数据回退 HomeBlocksDefaults。
               前两家在手机端也带出，其余只在桌面端第一行出现，并在手机端第二行只显示 Logo + 名称（同改造前）。 *@
            <div class="col-xs20 col-sm20 col-md20 col-lg20">
                @for (var index = 0; index < partners.Count; index++)
                {
                    var partner = partners[index];
                    var link = SafeLink(partner.Link);
                    <li class="@(index < 2 ? "col-xs10 col-sm10 col-md5 col-lg5" : "xs-hide sm-hide col-md5 col-lg5")">
                        @if (!string.IsNullOrWhiteSpace(partner.LogoPath))
                        {
                            if (link is not null)
                            {
                                <a href="@link" target="_blank" rel="noopener noreferrer" style="color: inherit;"><img loading="lazy" decoding="async" src="@partner.LogoPath" width="@partner.ImageWidth" height="@partner.ImageHeight" alt=""></a>
                            }
                            else
                            {
                                <img loading="lazy" decoding="async" src="@partner.LogoPath" width="@partner.ImageWidth" height="@partner.ImageHeight" alt="">
                            }
                        }
                        <h1@(link is null ? LiveEdit.Attr("Partner", partner.Id, "Name", partner.Name) : Microsoft.AspNetCore.Html.HtmlString.Empty)>@if (link is not null) {<a href="@link" target="_blank" rel="noopener noreferrer" style="color: inherit;"@LiveEdit.Attr("Partner", partner.Id, "Name", partner.Name)>@NameLines(partner.Name)</a>} else {@NameLines(partner.Name)}</h1>
                        @if (!string.IsNullOrWhiteSpace(partner.Description))
                        {
                            <p class="xs-hide sm-hide"@LiveEdit.Attr("Partner", partner.Id, "Description", partner.Description)>@partner.Description</p>
                        }
                    </li>
                }
            </div>



            @if (partners.Count > 2)
            {
            <div class="col-xs20 col-sm20 col-md20 col-lg20">
                @foreach (var partner in partners.Skip(2))
                {
                    var link = SafeLink(partner.Link);
                <li class="col-sm10 col-xs10 md-hide lg-hide">
                    @if (!string.IsNullOrWhiteSpace(partner.LogoPath))
                    {
                        if (link is not null)
                        {
                            <a href="@link" target="_blank" rel="noopener noreferrer" style="color: inherit;"><img loading="lazy" decoding="async" src="@partner.LogoPath" width="@partner.ImageWidth" height="@partner.ImageHeight" alt=""></a>
                        }
                        else
                        {
                            <img loading="lazy" decoding="async" src="@partner.LogoPath" width="@partner.ImageWidth" height="@partner.ImageHeight" alt="">
                        }
                    }
                    <h1@(link is null ? LiveEdit.Attr("Partner", partner.Id, "Name", partner.Name) : Microsoft.AspNetCore.Html.HtmlString.Empty)>@if (link is not null) {<a href="@link" target="_blank" rel="noopener noreferrer" style="color: inherit;"@LiveEdit.Attr("Partner", partner.Id, "Name", partner.Name)>@NameLines(partner.Name)</a>} else {@NameLines(partner.Name)}</h1>
                </li>
                }
            </div>
            }

        </ul>


        <div class="col-xs8 col-sm8 col-md8 col-lg8">&nbsp;</div>
    </div>
    <div class="col-xs2 col-sm2 col-md2 col-lg2">&nbsp;</div>
</section>

<section id="section03" class="xs-hide sm-hide md-hide lg-hide">
    <div class="col-xs2 col-sm2 col-md2 col-lg2">&nbsp;</div>
    <div class="col-xs16 col-sm16 col-md16 col-lg16">

        <!-- 合作案例 -->
        <p class="chapter JhengBold">合作案例&ensp;<i class="entitle">|</i>
            <span style="font-family: 'dinLightI';">COLLABORATION CASE</span>
        </p>
    </div>
    <div class="col-xs2 col-sm2 col-md2 col-lg2">&nbsp;</div>
</section>
