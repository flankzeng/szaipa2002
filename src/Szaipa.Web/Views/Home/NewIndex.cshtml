        <div class="hr"></div>

        @foreach (var n in Model.LatestNews)
        {
        if (n.Important != false)
        {
        <ul class="col-sm20 col-md20 col-lg20 important">
            <li class="col-sm5 col-md5 col-lg5 date JhengLight">@string.Format("{0:yyyy年MM月dd日}", n.Date)</li>
            <li class="col-sm14 col-md14 col-lg14 title importantTXT">
                <a href="/Home/newnewsread/@n.Id">
                    @n.Title
                    <p>@n.Subtitle</p>
                    <div>
                        <img loading="lazy" decoding="async" src="@ImagePreviewResolver.Resolve($"/Content/newsImg/{n.CoverPath}")" alt="">
                    </div>
                    <span class="JhengLight">查看全部 VIEW MORE</span>

                    <img loading="lazy" decoding="async" src="/Content/icon/enter-02.png" alt="" class="enter">
                </a>
            </li>
            <li class="col-sm1 col-md1 col-lg1">
                <img loading="lazy" decoding="async" src="/Content/icon/enter-02.png" class="enter">
            </li>
        </ul>
        <div class="hr col-xs20 col-sm20 col-md20 col-lg20" style="margin-top:0;"></div>
        }
        else
        {
        <ul class="col-sm20 col-md20 col-lg20 normal">
            <li class="col-sm5 col-md5 col-lg5 date JhengLight">@string.Format("{0:yyyy年MM月dd日}", n.Date)</li>
            <a href="/Home/newnewsread/@n.Id">
                <li class="col-sm14 col-md14 col-lg14 tite">@n.Title</li>
                <li class="col-sm1 col-md1 col-lg1"><img loading="lazy" decoding="async" src="/Content/icon/enter-02.png"
                        style="transform: translateX(20%);" alt="" class="enter">
                </li>
            </a>
        </ul>
        <div class="hr col-xs20 col-sm20 col-md20 col-lg20" style="margin-top:0;"></div>
        }
        }


