            <a href="@card.LinkUrl">
                <div class="card ended">
                    <p class="JhengRegular">
                        @card.Title<br />
                        @foreach (var line in card.InfoLines) { @line<br /> }
                    </p>
                    <span>查看更多</span>
                    @if (!string.IsNullOrEmpty(cover)) { <img loading="lazy" decoding="async" src="@ImagePreviewResolver.Resolve(cover)" alt="" /> }
                    <div class="filter-end"></div>
                </div>
            </a>
        }

        @* 已结束：按日期自动流转 + 手动「已结束」的数据库展览。兼容目录的 14 个历史展览（92001–92015）不在此列
              （一部分在下方硬编码卡片里，行为与 slug 迁移 SQL 是否执行无关）。封面优先用 CoverPath，缺省回退旧约定 card.jpg。 *@
        @foreach (var ex in Model.FeaturedPublications)
        {
            if (ex.GetLifecycle(today) != PublicationLifecycle.Ended
                || LegacyPublicationGalleryCatalog.GetImages(ex.Id).Count > 0)
            {
                continue;
            }

            var endedCardImage = string.IsNullOrEmpty(ex.CoverPath)
                ? $"/Content/images/{ex.FolderName}/card.jpg"
                : $"/Content/images/{ex.FolderName}/{ex.CoverPath}";
            <a href="/Home/Publication/@ex.Id">
                <div class="card ended">
                    <p class="JhengRegular">
                        @ex.TitleCn <br />
                        开始时间:@string.Format("{0:yyyy年MM月dd日}", ex.StartDate) <br />
                        结束时间:@string.Format("{0:yyyy年MM月dd日}", ex.EndDate) <br />
                        展览地点:@ex.Location
                    </p>
                    <span>
                        查看更多</span>
                    <img loading="lazy" decoding="async" src="@endedCardImage" />
                    <div class="filter-end"></div>
                </div>
            </a>
        }

