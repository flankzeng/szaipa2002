            style="height: var(--logoTXT);width: auto;margin-top: 2vh;margin-bottom: 2vh;" />
    </div>
    <div class="col-xs3 col-sm3 col-md3 col-lg3">&nbsp;</div>

    <!-- 轮播 -->
    <div class="col-xs20 col-sm20 col-md20 col-lg20" style="height: var(--carouselH);">

        <div class="swiper mySwiper" style="border:1px solid black">
            <div class="swiper-wrapper">

                @* 后台「首页推荐」勾选了「同时进轮播」的展览，排在硬编码轮播之前；首张实际可见封面是唯一 eager/high（LCP）。 *@
                @for (var featuredIndex = 0; featuredIndex < featuredSlides.Count; featuredIndex++)
                {
                    var ex = featuredSlides[featuredIndex].Item;
                    var coverSource = featuredSlides[featuredIndex].Cover
                        ?? throw new InvalidOperationException("Filtered featured slides must have a safe cover source.");
                    var isFirstSlide = featuredIndex == 0;
                    <div class="swiper-slide">

                        <a href="@ex.LinkUrl" class="carouselZoom">

                            <div class="outterL">
                                <p class="inner_new rotate_new">
                                    @ex.Title&#12288; @ex.YearText
                                </p>
                            </div>
                            <div class="outterR">
                                <p class="inner_new rotate_new">
                                    @ex.Title&#12288; @ex.YearText
                                </p>
                            </div>

                            <div class="black">

                                @if (ex.LogoUrl.Length > 0)
                                {
                                    <div class="logoCon">
                                        <img loading="@(isFirstSlide ? "eager" : "lazy")" decoding="async"
                                             src="@ex.LogoUrl" alt="">
                                    </div>
                                }

                                <picture>
                                    @if (coverSource.AvifUrl is not null)
                                    {
                                        <source type="image/avif" srcset="@coverSource.AvifUrl">
                                    }
                                    <img loading="@(isFirstSlide ? "eager" : "lazy")" decoding="async"
                                         fetchpriority="@(isFirstSlide ? "high" : "auto")" src="@coverSource.OriginalUrl"
                                         class="imgCon" alt="">
                                </picture>

                            </div>

                        </a>
                    </div>
                }

            @if (!carouselCoveredLinks.Contains("/Home/Publication/92015"))
