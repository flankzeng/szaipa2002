@model Szaipa.Data.Models.Home.PublicationDetailSnapshotModel
@using Szaipa.Web.Services
@{
    var publication = Model.Publication;
    ViewBag.Title = publication.TitleCn;
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
    ViewData["HtmlClass"] = "legacy-scale"; // 手机按旧站比例（public-core.css html.legacy-scale）
    var gallery = new ExhibitionGalleryModel
    {
        EditablePublicationId = ViewData["PublicationIsFallback"] is true ? null : publication.Id,
        TitleCn = publication.TitleCn,
        TitleEn = publication.TitleEn,
        StartDate = publication.StartDate,
        EndDate = publication.EndDate,
        FolderName = publication.FolderName,
        MaxImg = publication.MaxImg,
        ImagePaths = LegacyPublicationGalleryCatalog.GetImages(publication.Id),
        Preface = publication.Preface,
        Signature = publication.Signature,
        Works = publication.Works
    };
    var isImportant = publication.Type == 1;
    // 专题（Type == 2）：由后台积木拼装，走 _ExhibitionTopic；ImagePaths 仅保留给退役 slug 页，专题用文件夹约定编号。
    var isTopic = publication.Type == 2;
}

@if (isTopic)
{
    <partial name="_ExhibitionTopic" model="@Szaipa.Web.Models.ExhibitionTopicModel.Create(publication, gallery.ImagePaths)" />
}
else if (isImportant)
{
    <partial name="_ExhibitionImportant" model="gallery" />
}
else
{
    <partial name="_ExhibitionGallery" model="gallery" />
}

<!-- 邮件订阅块（手机版，共享 partial） -->
<partial name="_NewsletterSubscribeMobile" />

@section Styles {
    <link rel="stylesheet" href="~/public/vendor/swiper-public.css" asp-append-version="true" />
    <link rel="stylesheet" href="/Content/css/publication.css" />
    @if (isImportant || isTopic)
    {
        <link rel="stylesheet" href="~/css/public-pages.css" asp-append-version="true" />
    }
    @if (isTopic)
    {
        <link rel="stylesheet" href="~/css/exhibition-topic.css" asp-append-version="true" />
    }
}

@section Scripts {
    <script defer src="~/public/vendor/swiper-public.js" asp-append-version="true"></script>
    <script defer src="~/js/publication-gallery.js" asp-append-version="true"></script>
}
