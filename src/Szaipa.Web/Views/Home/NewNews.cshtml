@using Szaipa.Data.Models.Home
@model IReadOnlyList<NewsSummaryModel>
@{
    ViewBag.Title = "新闻动态";
    Layout = "~/Views/Shared/_newLayout.cshtml";
}

<style>
    ul {
        padding-inline-start: 0px;
    }

    li {
        list-style: none;
    }

    .xinwenzhanshi {
        height: 100%;
        width: 100vw;
        position: relative;
        margin-top: var(--newsTop);
        margin-bottom: 15vh;
    }

    .important .col-lg1 .enter {
        display: none;
        opacity: 0;
        visibility: hidden;
    }

    .important:hover {
        background-color: #00000003;
    }

    .normal:hover {
        background-color: #00000003;
    }

    .news {
        color: #bf272d;
        font-family: 'Noto Sans SC', sans-serif;
        font-display: swap;
        font-weight: 300;
        font-size: var(--newsFontsize);
        overflow: hidden;
    }

    .news h1 {
        font-size: var(--title);
        margin-top: 0;
    }

    .news ul {
        padding-bottom: var(--newsPadding);
        border-bottom: var(--normalNewsLine);
        margin: 0px;
    }

    .news ul>a>li {
        margin-top: 2vh;
        color: #bf272d;
        font-family: 'Noto Sans SC', sans-serif;
        font-display: swap;
        font-weight: 300;
        font-size: var(--newsFontsize);
    }

    .date {
        cursor: auto !important;
        margin-top: 2vh;
        color: #bf272d;
        font-family: var(--fontLight);
        font-size: var(--newsFontsize);
        padding-left: var(--dateLeft);
    }

    .hr {
        height: 0.5px;
        width: 100%;
        margin-top: 4vh;
        border-bottom: var(--normalNewsLine);
    }

    .enter {
        height: auto;
        width: var(--newsEnter);
        vertical-align: middle;
    }

    .normal:hover,
    .date,
    .title,
    .enter {
        transform: var(--newsHoverValue);
        transition: var(--newsHoverAnime);
    }

    .normal:hover,
    .normal:active,
    .normal:focus,
    .date,
    .title,
    .enter {
        transform: var(--newsHoverValue);
        transition: var(--newsHoverAnime);
    }

    .important {
        padding: 3vh 0 3vh 0 !important;
    }

    .important .date {
        margin-top: 0;
    }

    .important:hover,
    .date,
    .importantTXT {
        transform: var(--newsHoverValue);
        transition: var(--newsHoverAnime);
    }

    .importantTXT {
        position: relative;
    }

    .importantTXT .enter {
        position: absolute;
        bottom: 0;
        right: -1.4vw;
    }

    .importantTXT a {
        color: #bf272d;
        text-decoration: none;
    }

    .importantTXT p {
        color: black;
        margin-top: 20px;
        padding-right: 15%;
        text-align: justify;
        font-family: 'Noto Sans SC', sans-serif;
        font-display: swap;
        font-weight: 200;
        font-size: var(--newsPtag);
    }

    .importantTXT div {
        width: 80%;
        height: 80%;
        margin-top: 20px;
        margin-bottom: 10px;
        display: flex;
        align-items: left;
        justify-content: left;
        overflow: hidden;
    }

    .importantTXT div>img {
        width: 40%;
        max-height: 40vh;
        object-fit: cover;
    }

    .importantTXT span {
        font-family: var(--fontLight);
        font-size: var(--newsSpantag);
        border-bottom: 1px solid #bf272d;
        padding-bottom: 2px;
        margin-bottom: 30px;
    }
</style>

<article class="xinwenzhanshi col-sm20 col-md20 col-lg20">

    <div class="col-sm2 col-md2 col-lg2">&nbsp;</div>
    <div class="col-sm16 col-md16 col-lg16 news">
        <h1 class="JhengBold">
            新闻动态&emsp;<i style="font-style: normal;vertical-align: top;">|</i>&emsp;<span
                style="font-family: 'dinLightI';">NEWS</span>
        </h1>

        <!-- 第一行才有的 border-top，用分割线代替 -->
        <div class="hr"></div>

        @foreach (var news in Model)
        {
            @* Parity with legacy newnews: branch on raw Important == true, so null renders as a normal row. *@
            if (news.Important == true)
            {
                <ul class="col-sm20 col-md20 col-lg20 important">
                    <li class="col-sm5 col-md5 col-lg5 date">@string.Format("{0:yyyy.MM.dd}", news.Date)</li>
                    <li class="col-sm14 col-md13 col-lg13 title importantTXT">
                        <a href="/Home/newnewsread/@news.Id" target="_blank">
                            @news.Title
                            <p>@news.Subtitle</p>
                            <div>
                                <img src="/content/newsImg/@news.CoverPath" alt="">
                            </div>
                            <span>查看全部 VIEW MORE</span>

                            <img src="/Content/icon/enter-02.png" alt="" class="enter">
                        </a>
                    </li>
                    <li class="col-xs1 col-sm1 col-md1 col-lg1">
                        <img src="/Content/icon/enter-02.png" class="enter">
                    </li>
                </ul>
                <div class="hr col-xs20 col-sm20 col-md20 col-lg20" style="margin-top:0;"></div>
            }
            else
            {
                <ul class="col-sm20 col-md20 col-lg20 normal">
                    <li class="col-sm5 col-md5 col-lg5 date">@string.Format("{0:yyyy.MM.dd}", news.Date)</li>
                    @* Faithful to legacy newnews.cshtml: the normal-row target has a leading space (" _blank") — a legacy typo that opens links in one shared named window instead of a fresh tab. Preserved for parity; clean up in the later optimization pass. *@
                    <a href="/Home/newnewsread/@news.Id" target=" _blank">
                        <li class="col-sm14 col-md13 col-lg13 title">@news.Title</li>
                        <li class="col-xs1 col-sm1 col-md1 col-lg1">
                            <img src="/Content/icon/enter-02.png" style="transform: translateX(20%);" alt="" class="enter">
                        </li>
                    </a>
                </ul>
                <div class="hr col-xs20 col-sm20 col-md20 col-lg20" style="margin-top:0;"></div>
            }
        }

    </div>
    <div class="col-sm2 col-md2 col-lg2">&nbsp;</div>
</article>
