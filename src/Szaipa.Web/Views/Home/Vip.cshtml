@inject Szaipa.Web.Services.ILegacyImagePreviewResolver ImagePreviewResolver
@model IReadOnlyList<Szaipa.Data.Models.Home.ArtistSummaryModel>
    @{
    ViewData["Title"] = "会员风采";
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
    }

    @section Styles {
    <link rel="stylesheet" href="~/css/public-pages.css" asp-append-version="true" />
    }

    <main class="member-page">
        <header class="member-heading">
            <h1 class="JhengBold" style="color: #bf272d;">
                核心成员&ensp;<i class="entitle">|</i><span style="font-family: 'dinLightI';">&ensp; MEMBER</span>
            </h1>
        </header>

        @if (Model.Count == 0)
        {
        <p class="member-empty">暂时没有可展示的会员资料。</p>
        }
        else
        {
        <section class="member-grid" aria-label="会员列表">
            @foreach (var artist in Model)
            {
            <a class="member-card" href="@Szaipa.Web.Services.ArtistLinks.Href(artist.Id, ViewData[Szaipa.Web.Services.ArtistLinks.ViewDataKey] as IReadOnlySet<int>)">
                <figure>
                    <div class="member-card__image">
                        <img src="@ImagePreviewResolver.Resolve($"/Content/ArtImg/Artist/{artist.Path}")"
                            alt="@artist.ArtistNameCn" loading="lazy" decoding="async" />
                    </div>
                    <figcaption>
                        <strong>@LiveEdit.Field("Artist", artist.Id, "ArtistNameCN", artist.ArtistNameCn)</strong>
                        @if (!string.IsNullOrWhiteSpace(artist.ArtistNameEn))
                        {
                        <span>@LiveEdit.Field("Artist", artist.Id, "ArtistNameEN", artist.ArtistNameEn)</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(artist.Title))
                        {
                        <small>@LiveEdit.Field("Artist", artist.Id, "Title", artist.Title)</small>
                        }
                    </figcaption>
                </figure>
            </a>
            }
        </section>
        }
    </main>