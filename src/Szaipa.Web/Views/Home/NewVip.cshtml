@inject Szaipa.Web.Services.ILegacyImagePreviewResolver ImagePreviewResolver
@model IReadOnlyList<Szaipa.Data.Models.Home.ArtistSummaryModel>
@{
    ViewData["Title"] = "会员风采";
    Layout = "~/Views/Shared/_newLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/newvip.css" asp-append-version="true" />
}

<main class="member-page">
    <header class="member-heading">
        <p class="member-heading__title JhengBold">会员风采 <span>|</span></p>
        <p class="member-heading__english">MEMBERS</p>
    </header>

    @if (Model.Count == 0)
    {
        <p class="member-empty">暂时没有可展示的会员资料。</p>
    }
    else
    {
        <section class="member-grid" aria-label="会员列表">
            @foreach (var artist in Model)
            {
                <a class="member-card" href="/Home/newArt/@artist.Id">
                    <figure>
                        <img src="@ImagePreviewResolver.Resolve($"/Content/ArtImg/Artist/{artist.Path}")"
                             alt="@artist.ArtistNameCn"
                             loading="lazy"
                             decoding="async" />
                        <figcaption>
                            <strong>@artist.ArtistNameCn</strong>
                            @if (!string.IsNullOrWhiteSpace(artist.ArtistNameEn))
                            {
                                <span>@artist.ArtistNameEn</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(artist.Title))
                            {
                                <small>@artist.Title</small>
                            }
                        </figcaption>
                    </figure>
                </a>
            }
        </section>
    }
</main>
