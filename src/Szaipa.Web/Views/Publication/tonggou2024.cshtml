        .Select(index => $"/Content/images/tonggou2024/{index}.jpg")
        .Select(originalUrl => (
            OriginalUrl: originalUrl,
            PreviewUrl: ImagePreviewResolver.Resolve(originalUrl)))
        .ToArray();
}

