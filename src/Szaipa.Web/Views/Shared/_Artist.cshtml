@{
    var useBootstrapCss = ViewData["UseBootstrapCss"] is not false;
}
<!DOCTYPE html>

<html>

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewBag.Title - 深圳市艺术产业促进会</title>
    <meta name="keywords" content="艺术 文化 产业促进 产业园 画廊 展览 艺术展 当代艺术 艺术园区 文化产业园 产业发展 深圳市艺术产业促进会" />
    <link rel="icon" href="/Content/123/favicon.ico" type="image/x-icon">
    @if (useBootstrapCss)
    {
        <link rel="stylesheet" href="/Content/Model/css/bootstrap.css">
    }
    else
    {
        <link rel="stylesheet" href="~/css/public-bootstrap-baseline.css" asp-append-version="true">
    }
    <link rel="stylesheet" href="/Content/Model/css/Site.css">
    <link rel="stylesheet" href="/css/font-subsets.css" asp-append-version="true">
    <link rel="stylesheet" href="/content/model/css/responsive/Artist.css">
    <link rel="stylesheet" href="/Content/Model/css/responsive.css">
    <link rel="stylesheet" href="/Content/Model/css/swiper-bundle.min.css">

    <link rel="stylesheet" href="/css/public-layout-common.css" asp-append-version="true">
    <link rel="stylesheet" href="/css/public-layout-artist.css" asp-append-version="true">

    @* Page-specific stylesheets, loaded last so a page can override layout/library CSS. *@
    @await RenderSectionAsync("Styles", required: false)

    <!-- 以上共享 -->

</head>

<body>





    @RenderBody()

    @* Page-specific scripts, run right after the page body (before the layout's footer scripts). *@
