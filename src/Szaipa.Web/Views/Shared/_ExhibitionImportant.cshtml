@inject Szaipa.Web.Services.ILegacyImagePreviewResolver ImagePreviewResolver
@model Szaipa.Web.Models.ExhibitionGalleryModel
@{
    var bannerBg = $"/Content/images/{Model.FolderName}/10000.jpg";
    var mainImages = Model.ImagePaths.Count > 0
        ? Model.ImagePaths
        : Enumerable.Range(10001, Model.MaxImg + 1)
            .Select(number => $"/Content/images/{Model.FolderName}/{number}.jpg")
            .ToArray();
    var thumbnailImages = Model.ImagePaths.Count > 0
        ? Model.ImagePaths
        : Enumerable.Range(10000, Model.MaxImg + 1)
            .Select(number => $"/Content/images/{Model.FolderName}/{number}.jpg")
            .ToArray();
    var prefaceParagraphs = (Model.Preface ?? string.Empty)
        .Replace("\r\n", "\n")
        .Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
}

<section class="exh-banner" style="background-image: url('@bannerBg')">
    <div class="exh-banner__inner">
        <h1 class="exh-banner__title">@Model.TitleCn</h1>
        @if (!string.IsNullOrWhiteSpace(Model.TitleEn))
        {
            <div class="exh-banner__sub">@Model.TitleEn</div>
        }
        <div class="exh-banner__date">
            @if (Model.StartDate.HasValue)
            {
                <text>开幕 @Model.StartDate.Value.ToString("yyyy.MM.dd")</text>
            }
            @if (Model.EndDate.HasValue)
            {
                <text> — @Model.EndDate.Value.ToString("yyyy.MM.dd")</text>
            }
        </div>
    </div>
</section>

@if (prefaceParagraphs.Length > 0)
{
    <section class="exh-preface">
        <h2 class="exh-preface__h">序</h2>
        @foreach (var paragraph in prefaceParagraphs)
        {
            <p>@paragraph</p>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Signature))
        {
            <div class="exh-preface__sign">@Model.Signature</div>
        }
    </section>
}

@if (Model.Works.Count > 0)
{
    <section class="exh-works">
        <h2 class="exh-section-h">参展作品目录 <span style="font-family:'Szaipa Noto Sans SC','Szaipa Noto Sans SC GB',sans-serif;font-weight:300;">| WORKS</span></h2>
        <div class="exh-works__grid">
            @foreach (var work in Model.Works)
            {
                <div class="exh-works__item">
                    @if (!string.IsNullOrWhiteSpace(work.ImagePath))
                    {
                        <div class="exh-works__img">
                            <img src="@ImagePreviewResolver.Resolve(work.ImagePath)" alt="@work.Title" loading="lazy" decoding="async" />
                        </div>
                    }
                    <div class="exh-works__meta">
                        @if (!string.IsNullOrWhiteSpace(work.Category))
                        {
                            <span class="exh-works__cat">@work.Category</span>
                        }
                        <div class="exh-works__title">@work.Title</div>
                        @if (!string.IsNullOrWhiteSpace(work.Artist))
                        {
                            <div class="exh-works__artist">@work.Artist</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(work.Size) || !string.IsNullOrWhiteSpace(work.Medium))
                        {
                            <div class="exh-works__spec">
                                @string.Join(" · ", new[] { work.Size, work.Medium }.Where(part => !string.IsNullOrWhiteSpace(part)))
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </section>
}

<section class="col-xs20 col-sm20 col-md20 col-lg20">
    <h2 class="exh-section-h">现场照片 <span style="font-family:'Szaipa Noto Sans SC','Szaipa Noto Sans SC GB',sans-serif;font-weight:300;">| GALLERY</span></h2>
    <div class="col-xs2 col-sm2 col-md2 col-lg2">&nbsp;</div>
    <div class="col-xs16 col-sm16 col-md16 col-lg16 imgCon_Pub imgCon_PubMobCon">
        <div style=" --swiper-pagination-color: #fff" class="swiper mySwiper3">
            <div class="swiper-wrapper">
                @foreach (var imagePath in mainImages)
                {
                    <div class="swiper-slide">
                        <img loading="lazy" decoding="async" src="@imagePath" />
                    </div>
                }
            </div>
            <div class="swiper-button-next xs-hide sm-hide"></div>
            <div class="swiper-button-prev xs-hide sm-hide"></div>
        </div>
        <div thumbsSlider="" class="swiper mySwiper2 imgCon_PubSon imgCon_PubMob">
            <div class="swiper-wrapper">
                @foreach (var imagePath in thumbnailImages)
                {
                    <div class="swiper-slide">
                        <img loading="lazy" decoding="async" src="@imagePath" />
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-xs2 col-sm2 col-md2 col-lg2">&nbsp;</div>
</section>
