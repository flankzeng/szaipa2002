@model Szaipa.Web.Models.ExhibitionGalleryModel
@{
    var bannerBg = $"/Content/images/{Model.FolderName}/10000.jpg";
    var prefaceParagraphs = (Model.Preface ?? string.Empty)
        .Replace("\r\n", "\n")
        .Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
}

<section class="exh-banner" style="background-image: url('@bannerBg')">
    <div class="exh-banner__inner">
        <h1 class="exh-banner__title">@Model.TitleCn</h1>
        @if (!string.IsNullOrWhiteSpace(Model.TitleEn))
        {
            <div class="exh-banner__sub">@Model.TitleEn</div>
        }
        <div class="exh-banner__date">
            @if (Model.StartDate.HasValue)
            {
                <text>开幕 @Model.StartDate.Value.ToString("yyyy.MM.dd")</text>
            }
            @if (Model.EndDate.HasValue)
            {
                <text> — @Model.EndDate.Value.ToString("yyyy.MM.dd")</text>
            }
        </div>
    </div>
</section>

@if (prefaceParagraphs.Length > 0)
{
    <section class="exh-preface">
        <h2 class="exh-preface__h">序</h2>
        @foreach (var paragraph in prefaceParagraphs)
        {
            <p>@paragraph</p>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Signature))
        {
            <div class="exh-preface__sign">@Model.Signature</div>
        }
    </section>
}

<section class="col-xs20 col-sm20 col-md20 col-lg20">
    <h2 class="exh-section-h">现场照片 <span style="font-family:'Noto Sans SC',sans-serif;font-weight:300;">| GALLERY</span></h2>
    <div class="col-xs2 col-sm2 col-md2 col-lg2">&nbsp;</div>
    <div class="col-xs16 col-sm16 col-md16 col-lg16 imgCon_Pub imgCon_PubMobCon">
        <div style=" --swiper-pagination-color: #fff" class="swiper mySwiper3">
            <div class="swiper-wrapper">
                @for (var i = 10001; i <= 10001 + Model.MaxImg; i++)
                {
                    <div class="swiper-slide">
                        <img src="@string.Format("/Content/images/{0}/{1}.jpg", Model.FolderName, i)" />
                    </div>
                }
            </div>
            <div class="swiper-button-next xs-hide sm-hide"></div>
            <div class="swiper-button-prev xs-hide sm-hide"></div>
        </div>
        <div thumbsSlider="" class="swiper mySwiper2 imgCon_PubSon imgCon_PubMob">
            <div class="swiper-wrapper">
                @for (var i = 10000; i <= 10000 + Model.MaxImg; i++)
                {
                    <div class="swiper-slide">
                        <img src="@string.Format("/Content/images/{0}/{1}.jpg", Model.FolderName, i)" />
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-xs2 col-sm2 col-md2 col-lg2">&nbsp;</div>
</section>
