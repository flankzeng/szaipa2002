@model Szaipa.Web.Models.PageSkeletonViewModel

<section class="legacy-shell">
    <section class="hero-panel legacy-shell__hero">
        <p class="eyebrow">@Model.Eyebrow</p>
        <h1>@Model.Title</h1>
        <p class="lead">@Model.Lead</p>
    </section>

    <section class="legacy-meta-band">
        <article class="status-card legacy-meta-band__item">
            <p class="legacy-meta-band__label">Legacy route</p>
            <p class="legacy-meta-band__value">@Model.LegacyRoute</p>
        </article>
        <article class="status-card legacy-meta-band__item">
            <p class="legacy-meta-band__label">Repository</p>
            <p class="legacy-meta-band__value">@Model.TargetRepository</p>
        </article>
        <article class="status-card legacy-meta-band__item">
            <p class="legacy-meta-band__label">Batch</p>
            <p class="legacy-meta-band__value">@Model.TargetBatch</p>
        </article>
    </section>

    <section class="legacy-shell__content">
        <section class="workstream-panel legacy-shell__primary">
            <h2>Planned sections</h2>
            <div class="legacy-section-list">
                @foreach (var pageSection in Model.Sections)
                {
                    <article class="legacy-section-card">
                        <h3>@pageSection.Title</h3>
                        <p>@pageSection.Description</p>
                    </article>
                }
            </div>
        </section>

        <aside class="legacy-shell__secondary">
            @if (Model.Blueprint is not null)
            {
                <section class="workstream-panel">
                    <h2>Repository blueprint</h2>
                    <div class="legacy-blueprint-card">
                        <p class="legacy-blueprint-card__eyebrow">@Model.Blueprint.RepositoryName / @Model.Blueprint.MethodName</p>
                        <p class="legacy-blueprint-card__source">Source: @Model.Blueprint.Source</p>
                        <p>@Model.Blueprint.Purpose</p>
                        <div class="legacy-blueprint-card__block">
                            <p class="legacy-blueprint-card__label">Entities</p>
                            <ul class="legacy-blueprint-card__list">
                                @foreach (var entity in Model.Blueprint.Entities)
                                {
                                    <li>@entity</li>
                                }
                            </ul>
                        </div>
                        <div class="legacy-blueprint-card__block">
                            <p class="legacy-blueprint-card__label">Query steps</p>
                            <ol class="legacy-blueprint-card__list legacy-blueprint-card__list--ordered">
                                @foreach (var queryStep in Model.Blueprint.QuerySteps)
                                {
                                    <li>@queryStep</li>
                                }
                            </ol>
                        </div>
                    </div>
                </section>
            }

            @if (Model.TargetReadModels.Count > 0)
            {
                <section class="workstream-panel">
                    <h2>Target read models</h2>
                    <div class="legacy-model-list">
                        @foreach (var readModel in Model.TargetReadModels)
                        {
                            <article class="legacy-model-card">
                                <p class="legacy-model-card__name">@readModel.Name</p>
                                <p>@readModel.Purpose</p>
                            </article>
                        }
                    </div>
                </section>
            }

            @if (Model.QueryParameters.Count > 0)
            {
                <section class="workstream-panel">
                    <h2>Query parameters</h2>
                    <div class="legacy-parameter-list">
                        @foreach (var parameter in Model.QueryParameters)
                        {
                            <article class="legacy-parameter-card">
                                <p class="legacy-parameter-card__name">@parameter.Name</p>
                                <p class="legacy-parameter-card__value">@parameter.Value</p>
                                <p>@parameter.Reason</p>
                            </article>
                        }
                    </div>
                </section>
            }

            <section class="workstream-panel">
                <h2>First asset dependencies</h2>
                <div class="legacy-asset-list">
                    @foreach (var asset in Model.AssetDependencies)
                    {
                        <article class="legacy-asset-card">
                            <p class="legacy-asset-card__target">@asset.TargetPath</p>
                            <p>@asset.Reason</p>
                            <p class="legacy-asset-card__source">Source: @asset.SourcePath</p>
                        </article>
                    }
                </div>
            </section>

            <section class="workstream-panel">
                <h2>Next steps</h2>
                <ul class="legacy-next-steps">
                    @foreach (var step in Model.NextSteps)
                    {
                        <li>@step</li>
                    }
                </ul>
            </section>

            @if (Model.RemovedWriteBehaviors.Count > 0)
            {
                <section class="workstream-panel">
                    <h2>Write behaviors to remove</h2>
                    <div class="legacy-write-removal-list">
                        @foreach (var removedWrite in Model.RemovedWriteBehaviors)
                        {
                            <article class="legacy-write-removal-card">
                                <p class="legacy-write-removal-card__name">@removedWrite.LegacyBehavior</p>
                                <p>@removedWrite.Reason</p>
                            </article>
                        }
                    </div>
                </section>
            }

            @if (Model.Guardrails.Count > 0)
            {
                <section class="workstream-panel">
                    <h2>Read-only guardrails</h2>
                    <div class="legacy-guardrail-list">
                        @foreach (var guardrail in Model.Guardrails)
                        {
                            <article class="legacy-guardrail-card">
                                <h3>@guardrail.Title</h3>
                                <p>@guardrail.Detail</p>
                            </article>
                        }
                    </div>
                </section>
            }
        </aside>
    </section>
</section>
