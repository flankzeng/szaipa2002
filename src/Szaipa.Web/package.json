{
  "name": "szaipa-web-admin",
  "private": true,
  "version": "1.0.0",
  "description": "Tailwind + TipTap front-end build for the Szaipa staff backend (Areas/Staff).",
  "scripts": {
    "build:css": "tailwindcss -i ./wwwroot/admin/admin.input.css -o ./wwwroot/admin/admin.css --minify",
    "watch:css": "tailwindcss -i ./wwwroot/admin/admin.input.css -o ./wwwroot/admin/admin.css --watch",
    "build:js": "esbuild ./wwwroot/admin/src/editor.js --bundle --minify --format=iife --global-name=SzaipaEditor --outfile=./wwwroot/admin/editor.js",
    "build:dashboard": "esbuild ./wwwroot/admin/src/dashboard.js --bundle --minify --format=iife --outfile=./wwwroot/admin/dashboard.js",
    "build": "npm run build:css && npm run build:js && npm run build:dashboard"
  },
  "devDependencies": {
    "esbuild": "^0.24.2",
    "tailwindcss": "^3.4.17"
  },
  "dependencies": {
    "@tiptap/core": "^2.11.5",
    "@tiptap/extension-image": "^2.11.5",
    "@tiptap/extension-link": "^2.11.5",
    "@tiptap/extension-placeholder": "^2.11.5",
    "@tiptap/extension-text-align": "^2.11.5",
    "@tiptap/extension-underline": "^2.11.5",
    "@tiptap/pm": "^2.11.5",
    "@tiptap/starter-kit": "^2.11.5",
    "echarts": "^6.1.0"
  }
}
