<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.9" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Szaipa.Data/Szaipa.Data.csproj" />
  </ItemGroup>

  <!--
    Test-only suppression. EF Core 10's Microsoft.Data.Sqlite pulls SQLitePCLRaw.lib.e_sqlite3 2.1.11,
    which carries advisory GHSA-2m69-gcr7-jv3q. The fix is a SQLitePCLRaw 3.x bundle that Microsoft.Data.Sqlite
    10.0.9 does not target, so we do not force it. This native SQLite bundle is used ONLY by these unit tests
    and is never referenced by Szaipa.Web or Szaipa.Data (production uses SQL Server), so it does not ship.
  -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2m69-gcr7-jv3q" />
  </ItemGroup>

</Project>
